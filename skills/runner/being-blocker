#!/usr/bin/env bash
# being-blocker: tell the owner at once that work is blocked, instead of retrying blindly (no Teams kit needed).
# Logs to $BEING_STATE_DIR/blockers.jsonl; sends HTML on stdin through BEING_BLOCKER_SEND (your own sender) if set.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
ENVF="${BEING_RUNNER_ENV:-$HOME/.config/being-runner/env}"
# The file gives defaults; BEING_* already in the environment win.
keep="$(declare -px | grep -E '^declare -x BEING_' || true)"
set -a; [[ -f "$ENVF" ]] && . "$ENVF"; set +a; eval "$keep"
[[ $# -ge 3 ]] || { echo 'usage: being-blocker "<task>" "<what failed + exact error>" "<what you need>"' >&2; exit 2; }
STATE="${BEING_STATE_DIR:?set BEING_STATE_DIR in $ENVF}"
mkdir -p "$STATE"; umask 077
python3 - "$STATE/blockers.jsonl" "$1" "$2" "$3" <<'PY'
import json,sys,datetime
f,task,err,need=sys.argv[1:5]
open(f,"a").write(json.dumps({"at":datetime.datetime.now().astimezone().isoformat(),"task":task,"error":err,"need":need})+"\n")
PY
# Tasks matching a line in blocker-quiet.txt are logged only (reported in the job result instead).
if [[ -s "$STATE/blocker-quiet.txt" ]] && grep -qiF -f "$STATE/blocker-quiet.txt" <<<"$1"; then echo "blocker logged (quiet)"; exit 0; fi
[[ -n "${BEING_BLOCKER_SEND:-}" ]] || { echo "blocker logged (no BEING_BLOCKER_SEND set)"; exit 0; }
esc() { python3 -c 'import html,sys; print(html.escape(sys.argv[1]))' "$1"; }
read -ra send <<<"$BEING_BLOCKER_SEND"
if printf '<p>🚧 <b>Blocked: %s</b></p><p><b>What failed:</b> %s</p><p><b>Need from you:</b> %s</p><p>I have stopped retrying this step.</p>' \
  "$(esc "$1")" "$(esc "$2")" "$(esc "$3")" | "${send[@]}" >/dev/null; then
  echo "blocker sent"
else
  echo "blocker logged; sending failed (exit $?)" >&2; exit 1
fi
