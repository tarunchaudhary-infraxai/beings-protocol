#!/usr/bin/env bash
# being-job: long work that must outlive a reply, without the Teams kit. Runs headless Claude/Codex or a command,
# writes a result, appends to work.jsonl and calls BEING_ON_JOB_DONE. Usage: README.md.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"   # systemd and cron start with a bare PATH
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ENVF="${BEING_RUNNER_ENV:-$HOME/.config/being-runner/env}"
# The file gives defaults; BEING_* already in the environment win.
keep="$(declare -px | grep -E '^declare -x BEING_' || true)"
set -a; [[ -f "$ENVF" ]] && . "$ENVF"; set +a; eval "$keep"
STATE="${BEING_STATE_DIR:?set BEING_STATE_DIR in $ENVF}"; JOBS="$STATE/jobs"
WORKSPACE="${BEING_WORKSPACE:?set BEING_WORKSPACE in $ENVF}"
mkdir -p "$JOBS"; chmod 700 "$STATE" "$JOBS"
umask 077

usage() { echo "usage: being-job agent|codex <name> [--small] [--notify <target>] \"<task>\" | run <name> [--notify <target>] -- <cmd...>
       being-job list | status <id> | log <id> [n] | stop <id> [reason]" >&2; exit 2; }
json_get() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "$1" "$2"; }
valid_id() { [[ "$1" =~ ^[0-9]{4}-[0-9]{6}-[A-Za-z0-9-]+$ && -f "$JOBS/$1.json" ]] || { echo "no such job: $1" >&2; exit 2; }; }

start_job() {   # $1 kind, $2 name, $3 notify, $4 model, rest = payload
  local kind=$1 name=$2 notify=$3 model=$4 id; shift 4
  id="$(date +%m%d-%H%M%S)-$(printf '%s' "$name" | tr -cs 'A-Za-z0-9' '-' | cut -c1-24 | sed 's/-*$//')"
  python3 - "$JOBS/$id.json" "$id" "$kind" "$name" "$notify" "${BEING_JOB_ADD_DIRS:-}" "$model" "$@" <<'PY'
import json,sys,datetime,uuid
f,id_,kind,name,notify,add_dirs,model,*payload=sys.argv[1:]
json.dump({"id":id_,"kind":kind,"name":name,"notify":notify,"add_dirs":add_dirs,"model":model,"payload":payload,
           "session_id":str(uuid.uuid4()) if kind=="agent" else "","status":"running",
           "started":datetime.datetime.now().astimezone().isoformat()},open(f,"w"),indent=2)
PY
  setsid "$0" __exec "$id" </dev/null >/dev/null 2>&1 &
  echo "$id"
}

read -r -d '' RULES <<RULES || true
You are running a background job to completion. Work in the foreground only (no background tasks or agents): this process
ends when you finish. Do not message anyone except through being-blocker; the main session checks and delivers the result.
Final step: write a short result summary (what was produced, file paths, how you verified it, anything unverified or
blocked) to the RESULT file below.
- BLOCKERS: if a step fails twice for a reason outside your control (auth, permission, lock, quota, network, missing input,
  unclear ask, broken tool), STOP and run $BIN/being-blocker "<task>" "<exact error>" "<what you need>". No retry loops
  over 2 minutes. Then finish whatever else you can.
RULES

case "${1:-list}" in
  agent|codex|run)
    kind=$1; [[ $# -ge 2 ]] || usage; name=$2; shift 2
    model="${BEING_JOB_MODEL:-opus}"
    [[ "${1:-}" == --small ]] && { model="${BEING_JOB_MODEL_SMALL:-sonnet}"; shift; }
    notify=""; [[ "${1:-}" == --notify ]] && { notify=${2:?--notify needs a target}; shift 2; }
    [[ $kind == run && "${1:-}" == -- ]] && shift
    [[ $# -gt 0 ]] || { echo "nothing to run" >&2; exit 2; }
    start_job "$kind" "$name" "$notify" "$model" "$@" ;;
  __exec)
    id=$2; jf="$JOBS/$id.json"; log="$JOBS/$id.log"; result="$JOBS/$id.result.md"
    echo $$ >"$JOBS/$id.pid"   # setsid made this process a group leader: stop kills the group
    kind=$(json_get "$jf" kind)
    mapfile -t payload < <(python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["payload"]))' "$jf")
    set +e
    if [[ $kind == agent ]]; then
      (cd "$WORKSPACE" && claude -p --dangerously-skip-permissions --model "$(json_get "$jf" model)" \
        --session-id "$(json_get "$jf" session_id)" "$RULES
RESULT file: $result
Task:
${payload[*]}" </dev/null) >"$log" 2>&1
    elif [[ $kind == codex ]]; then
      extra=(); IFS=: read -ra dirs <<<"$(json_get "$jf" add_dirs)"
      for d in "${dirs[@]}"; do [[ -n $d ]] && extra+=(--add-dir "$d"); done
      (cd "$WORKSPACE" && codex exec --json --skip-git-repo-check -C "$WORKSPACE" -s workspace-write "${extra[@]}" \
        -c sandbox_workspace_write.network_access=true -o "$result" \
        "$RULES (Your final message is written to the RESULT file for you.)
Task:
${payload[*]}" </dev/null) >"$JOBS/$id.events.jsonl" 2>"$log"
    else
      (cd "$WORKSPACE" && "${payload[@]}") >"$log" 2>&1
    fi
    rc=$?; set -e
    # A model job that exits 0 without a result file is not "done".
    status=done; (( rc != 0 )) && status=failed
    [[ $kind != run && $status == done && ! -s "$result" ]] && status=no-result
    python3 - "$jf" "$rc" "$status" "$log" "$result" "$STATE/work.jsonl" <<'PY'
import json,sys,os,datetime
f,rc,st,log,res,q=sys.argv[1],int(sys.argv[2]),*sys.argv[3:]; d=json.load(open(f))
if d.get("status")=="stopped": st=d["status"]
d.update(status=st, exit=rc, finished=datetime.datetime.now().astimezone().isoformat()); json.dump(d,open(f,"w"),indent=2)
ev={"lane":"job","jobId":d["id"],"name":d["name"],"status":st,"exit":rc,"notify":d["notify"],"log":log,
    "result":res if os.path.exists(res) else "","at":d["finished"]}
open(q,"a").write(json.dumps(ev)+"\n")
PY
    rm -f "$JOBS/$id.pid"
    # Wake the main session (e.g. tmux send-keys or a poller nudge); the hook gets the job json path.
    if [[ -n "${BEING_ON_JOB_DONE:-}" ]]; then
      read -ra hook <<<"$BEING_ON_JOB_DONE"
      "${hook[@]}" "$jf" >>"$log" 2>&1 || echo "BEING_ON_JOB_DONE failed ($?)" >>"$log"
    fi ;;
  list)
    find "$JOBS" -maxdepth 1 -name '*.json' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -20 | cut -d' ' -f2- | while read -r f; do
      python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("%-34s %-9s %-5s %s  started %s%s" % (d["id"], d["status"], d["kind"], d["name"], d["started"][11:16], ("  exit %s" % d["exit"]) if "exit" in d else ""))' "$f"
    done ;;
  status) valid_id "${2:-}"; cat "$JOBS/$2.json"; if [[ -f "$JOBS/$2.result.md" ]]; then echo "--- result"; cat "$JOBS/$2.result.md"; fi ;;
  log) valid_id "${2:-}"; tail -n "${3:-40}" "$JOBS/$2.log" 2>/dev/null || true ;;
  stop)
    valid_id "${2:-}"
    python3 - "$JOBS/$2.json" "${3:-stopped}" <<'PY'
import json,sys,datetime
f,why=sys.argv[1:3]; d=json.load(open(f)); d.update(status="stopped",reason=why,finished=datetime.datetime.now().astimezone().isoformat()); json.dump(d,open(f,"w"),indent=2)
PY
    if [[ -f "$JOBS/$2.pid" ]]; then kill -- "-$(cat "$JOBS/$2.pid")" 2>/dev/null || true; rm -f "$JOBS/$2.pid"; fi
    echo "stopped $2" ;;
  *) usage ;;
esac
