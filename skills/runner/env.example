# being-runner settings: ~/.config/being-runner/env (0600), sourced by bash. kit-install.sh fills @...@ values.
# No secrets belong here.

# jobs/, work.jsonl and blockers.jsonl (kept 0700).
BEING_STATE_DIR="$HOME/.local/state/being-runner"
# The Being's home; jobs run here.
BEING_WORKSPACE="@WORKSPACE@"
BEING_JOB_MODEL=opus
BEING_JOB_MODEL_SMALL=sonnet
# Extra writable dirs for codex jobs, colon-separated.
BEING_JOB_ADD_DIRS=
# Command called with the finished job's json path; the default nudges the main tmux session.
BEING_ON_JOB_DONE="@RUNNER@/being-heartbeat --job"
# Your own sender: reads an HTML message on stdin and delivers it to the owner (exit 0 = sent).
BEING_BLOCKER_SEND=
# being-heartbeat: the tmux session to nudge and the prompt it gets.
BEING_SESSION="@BEING_NAME@"
BEING_HEARTBEAT_PROMPT="Heartbeat: read .beings/HEARTBEAT.md and act on it."
