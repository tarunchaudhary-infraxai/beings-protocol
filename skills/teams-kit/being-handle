voice_lane() {   # $1 lane, $2 that lane's queued messages; every number, link, negation and condition must survive
  local lane=$1 bv=$2 ob="$STATE/outbox" ov="$STATE/voice-out.$$.json" prompt
  prompt="MESSAGES:
$(python3 -c 'import json,sys; print(json.dumps([{"id":i["id"],"html":i["html"]} for i in json.load(open(sys.argv[1]))],ensure_ascii=False))' "$bv")"
  rm -f "$ov"
  if [[ "${BEING_VOICE_PASS:-on}" == off ]]; then log "voice pass off: sending originals"; echo '{"messages":[]}' >"$ov"
  elif fast_daily voice "$prompt" "$ov" "$lane" && [[ -s "$ov" ]]; then log "voice ok ($(lane_tag "$lane"))"; else log "voice FAILED; sending originals"; echo '{"messages":[]}' >"$ov"; fi
  python3 - "$bv" "$ov" "$KIT" "$ob" <<'PY' 2>>"$HLOG"
import json,sys,os,re,subprocess,html as H
from collections import Counter
items=json.load(open(sys.argv[1])); kit=sys.argv[3]; ob=sys.argv[4]
try: voiced={m["id"]:m["html"] for m in json.load(open(sys.argv[2])).get("messages",[])}
except Exception: voiced={}
text=lambda h: H.unescape(re.sub(r"<[^>]+>"," ",h)).replace("\u2019","'")
keys=lambda h: set(re.findall(r"https?://\S+|\d[\d,.]*\d|\d",text(h)))
hrefs=lambda h: set(re.findall(r'href="([^"]+)"',h))
def guards(h):   # a dropped "not" or "unless" changes a commitment: negations and conditions must survive
    t=text(h).lower(); c=Counter(re.findall(r"\b(?:unless|until|before|after|if|only|except)\b",t))
    c["neg"]=len(re.findall(r"\b(?:not|no|never|none|nothing|nobody|cannot|without)\b|n't\b",t)); return c
kept=lambda a,b: all(guards(b)[k]>=v for k,v in guards(a).items())
for it in items:
    h=voiced.get(it["id"],"").strip()
    ok=h and keys(it["html"])<=keys(h) and hrefs(it["html"])<=hrefs(h) and "](http" not in h and kept(it["html"],h)
    h,how=(h,"voiced") if ok else (it["html"],"original")
    a=["node",os.path.join(kit,"teams-send-dm.mjs"),"--chat",it["chatId"],"--verbatim"]
    a+=["--reply-to",it["quoteId"]] if it.get("quoteId") else ["--no-quote"]
    if it.get("attachUrl"): a+=["--attach-url",it["attachUrl"]]+(["--attach-name",it["attachName"]] if it.get("attachName") else [])
    sc=it.get("scope") or "owner-only"   # each message goes out under the scope it was queued with
    tok=subprocess.run(["node",os.path.join(kit,"scope.mjs"),"mint",sc,"1"],text=True,capture_output=True).stdout.strip()
    r=subprocess.run(a,input=h,text=True,capture_output=True,env={**os.environ,"BEING_SEND_TOKEN":tok,"BEING_VOICE":""})
    subprocess.run(["node",os.path.join(kit,"scope.mjs"),"revoke"],input=tok,text=True)
    print(f"voice {it['id']} ({how}) -> exit {r.returncode} {r.stderr.strip()[-200:]}",file=sys.stderr)
    dst=os.path.join(ob,"sent" if r.returncode==0 else "failed"); os.makedirs(dst,exist_ok=True)
    json.dump({**it,"final":h,"how":how,"exit":r.returncode},open(os.path.join(dst,it["id"]+".json"),"w"))
    os.remove(os.path.join(ob,it["id"]+".json"))
PY
  rm -f "$bv" "$ov"
}

