voice_flush_locked() {   # one fast-model call per lane, in that lane's session; then each message goes out under its own scope
  local ob="$STATE/outbox" g groups=()
  compgen -G "$ob/*.json" >/dev/null || return 0
  mapfile -t groups < <(python3 -c 'import json,sys,glob,os
ob,pre=sys.argv[1:3]; g={}
for f in sorted(glob.glob(os.path.join(ob,"*.json"))):
    it=json.load(open(f)); s=it.get("scope") or ""
    g.setdefault("team:"+s[6:].split(",")[0] if s.startswith("chats:") and s[6:] else "owner",[]).append(it)
for i,(lane,items) in enumerate(g.items()):
    p=f"{pre}.{i}.json"; json.dump(items,open(p,"w")); print(f"{lane}\t{p}")' "$ob" "$STATE/voice.$$")
  for g in "${groups[@]}"; do voice_lane "${g%%$'\t'*}" "${g#*$'\t'}"; done
