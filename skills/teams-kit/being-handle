# work-lane <tag>: drain one lane's inbox, batch after batch, under that lane's lock.
tag=${2:-}
[[ $tag =~ ^(owner|team-[0-9a-f]{10})$ ]] || { echo "usage: being-handle work-lane owner|team-<10 hex>" >&2; exit 2; }
LD="$STATE/lanes"; inbox="$LD/$tag.inbox.jsonl"
exec 9>"$LD/$tag.lock"; flock -n 9 || exit 0   # the runner that holds it drains what was just added (it checks after each batch)
lane=$(cat "$LD/$tag.lane")
# Upgrade bridge: a pre-lane handler holds handler.lock exclusively for its whole drain; wait for it to finish.
exec 6>"$STATE/handler.lock"; flock -s 6
while :; do
  batch="$STATE/work.$$.jsonl"
  flock "$STATE/work-queue.lock" sh -c '[ -s "$1" ] && mv "$1" "$2"; exit 0' _ "$inbox" "$batch"
  [[ -s "$batch" ]] || { rm -f "$batch"; batch=""; break; }
  log "work-lane $tag: batch of $(wc -l <"$batch")"
  run_lane_batch "$batch" "$lane"
  rm -f "$batch"; batch=""
done
exec 9>&- 6>&-
# Added between our last check and the unlock: no runner saw it, so take it (or the new holder already has).
[[ -s "$inbox" ]] && exec "$KIT/being-handle" work-lane "$tag"
exit 0
