#!/usr/bin/env bash
# being-handle warm|triage|work|work-lane|voice: the message pipeline (README.md: the flow; "Script notes": locks).
# Triage and work lock separately, and work locks per lane, so a long run never delays acks or another person's run.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"   # started from systemd units and hooks with a bare PATH (review #7: claude exit 127)

KIT="${BEING_KIT_HOME:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)}"
set -a
# shellcheck source=/dev/null
. "$KIT/.env"
set +a
STATE="${BEING_STATE_DIR:?}"; HLOG="$STATE/handler.log"
# OS isolation (isolation/README.md): model runs of a sandboxed lane start through being-launch. BEING_ISOLATION_LANES=team
# sandboxes teammate lanes only; the owner lane then runs exactly as with BEING_ISOLATION=off.
ISO="${BEING_ISOLATION:-off}"
sandboxed() { [[ $ISO != off ]] && { [[ ${BEING_ISOLATION_LANES:-all} == all ]] || [[ $1 == team:* ]]; }; }
# A live steer relay would start a model as the kit user next to a sandboxed run: with every lane sandboxed, notes take the
# durable path (teammate-only: mesh.py queues messages for a sandboxed lane instead of injecting them live).
[[ $ISO != off && ${BEING_ISOLATION_LANES:-all} == all ]] && export BEING_STEER_CMD=/bin/false
WORKSPACE="${BEING_WORKSPACE:-$(cd "$KIT/../.." && pwd)}"
KREL=$(python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$KIT" "$WORKSPACE")
CLAUDE_DIR="$HOME/.claude/projects/$(readlink -f "$WORKSPACE" | sed 's#[/.]#-#g')"
CLAUDE_BIN="${BEING_CLAUDE_BIN:-claude}"; CODEX_BIN="${BEING_CODEX_BIN:-codex}"   # sandboxed runs use the launcher's own client
LIMIT_RE="${BEING_LIMIT_PATTERN:-hit your (session|usage) limit|usage limit reached|session limit reached}"
stage="${1:-triage}"
# Log time with ms, for the per-stage latency trail (bash clock: no fork, and `date +%3N` is unreliable on uutils).
ts() { local t=$EPOCHREALTIME; printf '%(%FT%T)T.%s%(%z)T' "${t%.*}" "${t:(-6):3}" "${t%.*}"; }
log() { echo "$(ts) [$stage] $*" >>"$HLOG"; }
owner_side() {   # settings stages: an interactive shell (no grant) or the owner lane's full grant, never a delegate/teammate run
  [[ -z ${BEING_SEND_TOKEN:-} ]] || [[ $(node "$KIT/scope.mjs" show 2>/dev/null) == full ]] || { echo "refused: owner lane only" >&2; exit 3; }
}
if [[ $stage == quiet ]]; then   # quiet on|off|status: today's quiet mode (BEING_QUIET_MODE=1 makes it count)
  qf="$STATE/quiet/$(date +%F)"
  case ${2:-status} in
    on) owner_side; mkdir -p "${qf%/*}"; : >"$qf"; echo "quiet mode on for $(date +%F)" ;;
    off) owner_side; rm -f "$qf"; echo "quiet mode off" ;;
    status) echo "quiet: $([[ -e $qf ]] && echo on || echo off) today (feature $([[ ${BEING_QUIET_MODE:-0} == 1 ]] && echo enabled || echo disabled))"
            ls "$STATE/carryover/"*.jsonl 2>/dev/null | while read -r f; do echo "carryover $(basename "$f" .jsonl): $(wc -l <"$f") message(s)"; done ;;
    *) echo "usage: being-handle quiet on|off|status" >&2; exit 2 ;;
  esac; exit 0
fi
if [[ $stage == owner-alias ]]; then   # owner-alias add <chatId> <hours> | remove <chatId> | list (BEING_OWNER_ALIAS=1)
  owner_side
  flock "$STATE/owner-alias.lock" python3 - "$STATE/owner-alias.json" "${BEING_OWNER_ALIAS_MAX_H:-12}" "${@:2}" <<'PY'
import json,sys,os,re,datetime as dt
f,maxh,*a=sys.argv[1:]; now=dt.datetime.now(dt.timezone.utc)
try: rows=json.load(open(f))
except (OSError,ValueError): rows=[]
def live(r):
    try: u=dt.datetime.fromisoformat(str(r["until"])); return bool(u.tzinfo) and u>now and bool(r.get("chatId"))
    except (KeyError,TypeError,ValueError): return False
rows=[r for r in rows if isinstance(rows,list) and isinstance(r,dict) and live(r)] if isinstance(rows,list) else []
cmd=a[0] if a else "list"
if cmd=="add":
    if len(a)<3 or not re.fullmatch(r"[^\s]{3,300}",a[1]): sys.exit("usage: owner-alias add <chatId> <hours>")
    h=min(float(a[2]),float(maxh)); rows=[r for r in rows if r["chatId"]!=a[1]]
    rows.append({"chatId":a[1],"until":(now+dt.timedelta(hours=h)).isoformat(timespec="seconds")})
elif cmd=="remove": rows=[r for r in rows if r["chatId"]!=(a[1] if len(a)>1 else "")]
elif cmd!="list": sys.exit("usage: being-handle owner-alias add <chatId> <hours> | remove <chatId> | list")
if cmd!="list":
    t=f+".tmp"; fd=os.open(t,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600); os.write(fd,json.dumps(rows,indent=1).encode()); os.close(fd); os.replace(t,f)
for r in rows: print(f"{r['chatId']}  until {r['until']}")
if not rows: print("no owner-alias chats")
PY
  exit 0
fi
[[ -e "$STATE/STANDBY" ]] && { log "standby: skipped"; exit 0; }

# work: a quick dispatcher into per-lane inboxes (work-queue.lock); work-lane: one runner per lane, under its own lock.
# Other shared files keep their own flock (README "Script notes").
[[ "$stage" == work || "$stage" == work-lane ]] || { exec 9>"$STATE/triage.lock"; flock -n 9 || exit 0; }
day=$(date +%F)
batch=""
trap 'rm -f "$STATE/work-session.$$" "$STATE"/fast-sys.$$.*.txt; [[ -n "$batch" && -s "$batch" ]] && { cat "$batch" >>"$STATE/failed.jsonl"; rm -f "$batch"; log "aborted; batch kept in failed.jsonl"; }' EXIT

uuid5() { python3 -c 'import uuid,sys; print(uuid.uuid5(uuid.NAMESPACE_URL, sys.argv[1]))' "$1"; }
# Owner-alias chats (BEING_OWNER_ALIAS=1): unexpired 1:1 chats in state/owner-alias.json, each capped at
# BEING_OWNER_ALIAS_MAX_H hours ahead; the owner is typing from there for now, so those messages take the owner lane.
ALIAS_PY='
def owner_aliases(st):
    import json,os,datetime as dt
    if os.environ.get("BEING_OWNER_ALIAS","0")!="1": return set()
    now=dt.datetime.now(dt.timezone.utc); cap=now+dt.timedelta(hours=float(os.environ.get("BEING_OWNER_ALIAS_MAX_H") or 12)); out=set()
    try: rows=json.load(open(os.path.join(st,"owner-alias.json")))
    except (OSError,ValueError): return out
    for r in rows if isinstance(rows,list) else []:
        try:
            u=dt.datetime.fromisoformat(str(r["until"]))
            if u.tzinfo and now<u<=cap: out.add(str(r["chatId"]))
        except (KeyError,TypeError,ValueError): pass
    return out
def mark_alias(m,al):
    m.pop("ownerAlias",None)
    if m.get("chatId") in al and m.get("chatType")=="oneOnOne" and m.get("lane")!="owner" and m.get("addressedBy")!="note": m["ownerAlias"]=True
    return m
'
quiet_today() { [[ ${BEING_QUIET_MODE:-0} == 1 && -e "$STATE/quiet/$day" ]]; }
codex_name() {   # $1 events file, $2 name: label the Codex thread in Codex's own thread index, as its rename does
  [[ ${BEING_CODEX_THREAD_NAMES:-1} == 1 ]] || return 0
  local tid idx="${CODEX_HOME:-$HOME/.codex}/session_index.jsonl"
  tid=$(python3 -c 'import json,sys
for l in open(sys.argv[1]):
    try: e=json.loads(l)
    except ValueError: continue
    if e.get("type")=="thread.started": print(e.get("thread_id","")); break' "$1" 2>/dev/null) || return 0
  [[ $tid =~ ^[A-Za-z0-9-]+$ && -d ${idx%/*} ]] || return 0
  python3 -c 'import json,sys,datetime; print(json.dumps({"id":sys.argv[1],"thread_name":sys.argv[2],"updated_at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")}))' \
    "$tid" "$2" >>"$idx" 2>/dev/null || true
}
# Lanes: "owner" (owner's 1:1, delegate, owner jobs) or "team:<chatId>" (one per teammate chat). Sessions never cross lanes.
lane_of_scope() {   # = mesh.lane_of_scope: a scope that is not valid (none, empty) is no lane at all, never the owner
  case $1 in chats:?*) local c=${1#chats:}; echo "team:${c%%,*}" ;; full|owner-only|routine:?*) echo owner ;; *) echo denied ;; esac
}
lane_tag() { if [[ $1 == owner ]]; then echo owner; else printf 'team-%s' "$(printf '%s' "${1#team:}" | sha1sum | cut -c1-10)"; fi; }
lane_key() { if [[ $1 == owner ]]; then echo ""; else echo "/$1"; fi; }   # suffix for session ids; owner keeps the plain daily id
render() {   # fill {{…}} placeholders in static prompt text
  local s=$1
  s=${s//\{\{BEING\}\}/$BEING_NAME}; s=${s//\{\{OWNER\}\}/${OWNER_NAME:-the owner}}
  s=${s//\{\{OWNER_OID\}\}/${OWNER_OID:-}}; s=${s//\{\{KIT\}\}/$KREL}
  printf '%s' "$s"
}

json_from() {   # $1 raw model reply, $2 output file: the JSON object in it
  python3 -c 'import json,sys
t=open(sys.argv[1]).read(); s=t.find("{"); e=t.rfind("}")
json.dump(json.loads(t[s:e+1]),open(sys.argv[2],"w"))' "$1" "$2" 2>>"$STATE/fast.log"
}

# The soul every claude launch carries (soul.py): the full SOUL.md in the owner lane, the generated public soul
# (state/soul-public.md, private passages removed) in a teammate lane. Empty only when SOUL.md is missing (logged).
soul_file() {   # $1 lane
  local f; f=$(python3 "$KIT/soul.py" file "$1" 2>>"$HLOG") || f=""
  [[ -n $f && -s $f ]] || { log "SOUL MISSING for $(lane_tag "$1"): this launch runs without the soul"; f=""; }
  printf '%s' "$f"
}
soul_args() {   # $1 lane, $2 resuming (1|0): --append-system-prompt-file flags (NUL-separated). A resumed session re-renders
  # its system prompt (snapshot off): sessions started before the soul existed, or before SOUL.md changed, still get it.
  local f; f=$(soul_file "$1"); [[ -n $f ]] || return 0
  printf '%s\0' --append-system-prompt-file "$f"; [[ ${2:-0} == 1 ]] && printf '%s\0' --system-prompt-snapshot off
  return 0
}

fast_sys() {   # $1 lane: the warm lane's system prompt: soul + warm digest (soul.py) + both fast tasks' rules and schemas
  local lane=${1:-owner} f d
  f="$STATE/fast-sys.$$.$(lane_tag "$lane").txt"
  if [[ ! -s "$f" ]]; then
    # The digest is frozen between changes of the board, DECISIONS.md, GOALS.md or SOUL.md (and the day), so this prompt and the
    # lane's process stay the same from message to message; when it changes, the lane restarts once with the fresh digest.
    d=$(python3 "$KIT/soul.py" digest "$lane" 2>>"$HLOG") || d=""
    [[ -s $d ]] || { log "warm digest failed ($(lane_tag "$lane")); soul only"; d=$(soul_file "$lane"); }
    printf '%s\n%s\n[triage] turns:\n%s\nTriage JSON Schema: %s\n[voice] turns:\n%s\nVoice JSON Schema: %s\n' "$(render "$FAST_SYS")" \
      "$( [[ -n $d ]] && cat "$d")" "$(render "$TRIAGE_RULES")" "$(tr -d '\n ' <"$KIT/ack-schema.json")" \
      "$(render "$VOICE_RULES")" "$(tr -d '\n ' <"$KIT/voice-schema.json")" >"$f"
  fi
  printf '%s' "$f"
}

session_name() {   # $1 lane|warm|job, $2 lane id or job name, [$3 messages file]: the readable session name (being-sessions name)
  python3 "$KIT/being-sessions" name "$1" "$2" ${3:+--msgs "$3"} 2>>"$HLOG" || echo "${BEING_NAME,,}-$1"
}

fast_daily() {   # $1 task (triage|voice), $2 turn data, $3 output JSON file, $4 lane, $5 session name; warm lane process first, cold call as fallback
  local task=$1 data=$2 out=$3 lane=${4:-owner} name=${5:-} rc schema rules prompt
  [[ -n $name ]] || name=$(session_name warm "$lane")
  if [[ $task == voice ]]; then schema=$KIT/voice-schema.json; rules=$VOICE_RULES; else schema=$KIT/ack-schema.json; rules=$TRIAGE_RULES; fi
  # Runs in an empty directory, not the workspace: triage and voice have no reason to open files.
  local fcwd="$STATE/fast-cwd"; mkdir -p "$STATE/fast-daily" "$fcwd"
  set +e
  if [[ "${BEING_FAST_CLIENT:-codex}" == claude && "${BEING_FAST_WARM:-1}" == 1 ]]; then
    # Warm path: the lane's long-lived process (fast-warm.mjs under being-teams) already holds the rules as its system prompt;
    # model and effort go with every turn, so an .env change restarts the lane on its next message.
    local tmo=${BEING_FAST_WARM_TIMEOUT_MS:-15000} t0=$EPOCHREALTIME
    [[ $task == voice ]] && tmo=$(( tmo * 3 ))
    # Client in Python (starts in ~30 ms; node takes ~200 ms on this box): exit 2 no daemon, 3 timeout/model error, 4 no JSON.
    printf '[%s · %s]\n%s\nReply with ONLY the %s JSON object.' "$task" "$(date '+%F %H:%M')" "$data" "$task" \
      | python3 -c 'import json,socket,sys
sock,lane,tmo,sysf,out,model,effort,name=sys.argv[1:9]; tmo=int(tmo)
try:
    s=socket.socket(socket.AF_UNIX); s.settimeout(tmo/1000+1.5); s.connect(sock)
except OSError as e: print(f"fast-warm: no daemon ({e})",file=sys.stderr); sys.exit(2)
try:
    s.sendall((json.dumps({"lane":lane,"name":name,"timeoutMs":tmo,"sys":open(sysf).read(),"prompt":sys.stdin.read(),"model":model,"effort":effort})+"\n").encode())
    b=b""
    while (c:=s.recv(65536)): b+=c
    r=json.loads(b)
except Exception as e: print(f"fast-warm: {e!r}",file=sys.stderr); sys.exit(3)
if not r.get("ok"): print("fast-warm:",lane,r.get("error"),file=sys.stderr); sys.exit(3)
t=r["text"]; i=t.find("{"); j=t.rfind("}")
try: json.dump(json.loads(t[i:j+1]),open(out,"w"))
except Exception as e: print(f"fast-warm: no JSON in reply ({e})",file=sys.stderr); sys.exit(4)' \
        "$STATE/fast-warm.sock" "$lane" "$tmo" "$(fast_sys "$lane")" "$out" "${BEING_FAST_MODEL:-haiku}" "${BEING_FAST_EFFORT:-}" "$name" 2>>"$STATE/fast.log"; rc=$?
    if (( rc == 0 )); then set -e; log "fast warm ok ($task, $(lane_tag "$lane"), $(( (${EPOCHREALTIME/./} - ${t0/./}) / 1000 )) ms)"; return 0; fi
    log "fast warm failed ($task, rc $rc: $(case $rc in 2) echo no daemon;; 4) echo no JSON;; *) echo timeout/error;; esac)); cold fallback"
  fi
  prompt="[Teams $task · $day]
$(render "$rules")
$data"
  if [[ "${BEING_FAST_CLIENT:-codex}" == codex ]]; then
    local idf="$STATE/fast-daily/$day.id" ev="$STATE/fast-events.$$.jsonl"
    [[ $lane == owner ]] || idf="$STATE/fast-daily/$day.$(lane_tag "$lane").id"
    local common=(--skip-git-repo-check -c "model_reasoning_effort=${BEING_FAST_EFFORT:-low}" -c sandbox_mode=read-only --output-schema "$schema" -o "$out")
    if [[ -s "$idf" ]]; then
      (cd "$fcwd" && "$CODEX_BIN" exec resume "$(cat "$idf")" "${common[@]}" "$prompt" </dev/null >/dev/null 2>>"$STATE/fast.log"); rc=$?
    else
      (cd "$fcwd" && "$CODEX_BIN" exec -C "$fcwd" --json "${common[@]}" "$prompt" </dev/null >"$ev" 2>>"$STATE/fast.log"); rc=$?
      codex_name "$ev" "$day $name"
      python3 -c 'import json,sys
for l in open(sys.argv[1]):
    try: e=json.loads(l)
    except Exception: continue
    if e.get("type")=="thread.started": print(e["thread_id"]); break' "$ev" >"$idf" 2>/dev/null
      [[ -s "$idf" ]] || rm -f "$idf"; rm -f "$ev"
    fi
  else
    # Claude as the fast client: no tools at all, JSON extracted from the reply. Lean start: no MCP servers or claude.ai
    # connectors (they put ~95k tokens of tool lists into every turn), no skills, no auto-memory, no non-essential traffic.
    local sid args raw="$STATE/fast-raw.$$.txt" cdir sargs=() res=0
    cdir="$HOME/.claude/projects/$(readlink -f "$fcwd" | sed 's#[/.]#-#g')"
    # "being-fast2": sessions started before the lean flags carry the connector tool lists in their history.
    sid=$(uuid5 "being-fast2/$BEING_NAME/$day$(lane_key "$lane")"); args=(--session-id "$sid")
    [[ -f "$cdir/$sid.jsonl" ]] && { args=(--resume "$sid"); res=1; }
    mapfile -d '' -t sargs < <(soul_args "$lane" "$res")
    (cd "$fcwd" && ENABLE_CLAUDEAI_MCP_SERVERS=false CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
      "$CLAUDE_BIN" -p -n "$name" --model "${BEING_FAST_MODEL:-haiku}" ${BEING_FAST_EFFORT:+--effort "$BEING_FAST_EFFORT"} --tools "" --strict-mcp-config \
      --disable-slash-commands "${sargs[@]}" "${args[@]}" \
      "$prompt
Reply with ONLY one JSON object (no prose, no code fence) valid against this JSON Schema: $(tr -d '\n ' <"$schema")" </dev/null >"$raw" 2>>"$STATE/fast.log"); rc=$?
    json_from "$raw" "$out" || rc=1
    rm -f "$raw"
  fi
  set -e
  return $rc
}

reply_map() {   # {"chatId": latest messageId} so replies quote what they answer
  [[ -s "${1:-}" ]] || { echo '{}'; return; }
  python3 -c 'import json,sys
m={}
for l in open(sys.argv[1]):
    if l.strip():
        x=json.loads(l)
        if x.get("chatId") and x.get("messageId") and not str(x["messageId"]).startswith(("note:","job:")): m[x["chatId"]]=x["messageId"]
print(json.dumps(m))' "$1"
}

team_perms() {   # permission flags for teammate-lane runs: the fence, plus no skipped permissions on an acknowledged one-user host
  local flags; flags=(--settings "$(python3 "$KIT/team-fence.py" --settings)")
  if [[ "${BEING_SINGLE_USER_ACK:-0}" == 1 ]]; then
    local k=$KREL
    flags+=(--permission-mode dontAsk --allowedTools "${BEING_TEAM_TOOLS:-Read,Grep,Glob,WebFetch,WebSearch,Bash(node $k/teams-send-dm.mjs:*),Bash(node $k/teams-fetch-attachment.mjs:*),Bash($k/being-job agent:*),Bash($k/being-job codex:*),Bash($k/being-job list:*),Bash($k/being-job status:*),Bash($k/being-job log:*),Bash($k/being-status:*),Bash($k/being-blocker:*),Bash($k/being-board:*),Bash($k/being-steer:*),Bash(git log:*),Bash(git show:*),Bash(git diff:*),Bash(gh pr view:*),Bash(gh pr diff:*)}")
  else
    flags+=(--dangerously-skip-permissions)
  fi
  printf '%s\0' "${flags[@]}"
}

transcript_of() {   # $1 lane, $2 session id: a kit-readable path to that session's transcript (sandboxed runs keep theirs elsewhere)
  if ! sandboxed "$1"; then printf '%s' "$CLAUDE_DIR/$2.jsonl"; else "$KIT/being-launch" transcript "$1" "$2" 2>/dev/null || printf '/nonexistent'; fi
}

work_daily() {   # $1 prompt, $2 send scope, $3 batch file, $4 lane, $5 session name; runs in the lane's work session for today
  local lane=${4:-owner} name=${5:-} sid args tok rc cpid perm=bypassPermissions perms=() env=() sargs=() res=0
  [[ -n $name ]] || name=$(session_name lane "$lane")
  sid=$(uuid5 "being-daily/$BEING_NAME/$day$(lane_key "$lane")"); args=(--session-id "$sid")
  [[ -f "$(transcript_of "$lane" "$sid")" ]] && { args=(--resume "$sid"); res=1; }
  mapfile -d '' -t sargs < <(soul_args "$lane" "$res")   # the soul, always: full in the owner lane, public in a teammate lane
  if [[ $lane == owner ]]; then perms=(--dangerously-skip-permissions)
  else mapfile -d '' -t perms < <(team_perms); env=(CLAUDE_CODE_DISABLE_AUTO_MEMORY=1)
       [[ "${BEING_SINGLE_USER_ACK:-0}" == 1 ]] && perm=dontAsk; fi
  tok=$(node "$KIT/scope.mjs" mint "$2") || return 1   # the run gets an opaque grant, not the scope itself
  printf '%s %s %s\n' "$sid" "$lane" "$name" >"$STATE/work-session.$$"   # being-status / being-watchdog follow the running session
  # Named (-n) so it shows in ListAgents and being-sessions; no SendMessage tool: other sessions are reached only through
  # being-steer, which checks scope and logs every note. exec: $! is the claude process itself, for the registry.
  local launch=() a
  if sandboxed "$lane"; then   # behind the OS boundary: the grant goes to the run's broker, never into the model's env
    launch=("$KIT/being-launch" "$lane" --cwd "$WORKSPACE")
    for a in "${sargs[@]}"; do [[ -f $a ]] && launch+=(--expose "$a"); done
    if [[ $lane == team:* ]] && ! python3 "$KIT/team-sync" "${lane#team:}" >>"$HLOG" 2>&1; then
      log "team-sync failed for $(lane_tag "$lane"): run refused"; printf '%s' "$tok" | node "$KIT/scope.mjs" revoke; return 1
    fi
    launch+=(--)
  fi
  local cbin=$CLAUDE_BIN rout="$STATE/run-out.$$.txt"; [[ ${#launch[@]} -gt 0 ]] && cbin=claude
  (cd "$WORKSPACE" && exec env "${env[@]}" BEING_LANE="$lane" BEING_SESSION_NAME="$name" BEING_VOICE="$([[ ${BEING_VOICE_PASS:-on} == off ]] || echo fast)" BEING_SEND_TOKEN="$tok" \
    BEING_REPLY_TO="$(reply_map "${3:-}")" "${launch[@]}" "$cbin" -p -n "$name" "${perms[@]}" --disallowedTools SendMessage \
    --model "${BEING_SESSION_MODEL:-opus}" "${sargs[@]}" "${args[@]}" "$1" </dev/null) >"$rout" 2>&1 &
  cpid=$!
  python3 "$KIT/being-sessions" register --name "$name" --lane "$lane" --kind work --pid "$cpid" --sid "$sid" --perm "$perm" 2>>"$HLOG" || true
  wait "$cpid"; rc=$?
  cat "$rout" >>"$HLOG"   # this run's own output: a limit message from a parallel lane never triggers a fallback here
  # Ended; a note delivered live that this run never read takes the durable path (the lane's queue).
  python3 "$KIT/being-sessions" end --name "$name" --pid "$cpid" --transcript "$(transcript_of "$lane" "$sid")" >>"$HLOG" 2>&1 || true
  if (( rc != 0 )) && [[ ${BEING_WORK_FALLBACK:-codex} == codex ]] && grep -qiE "$LIMIT_RE" "$rout"; then
    if [[ $lane == owner ]]; then
      log "claude usage limit ($name): codex fallback"
      work_codex "$1" "$tok" "${3:-}" "$lane" "$name" "${launch[@]}"; rc=$?
    else log "claude usage limit ($name): no codex fallback in a teammate lane (the fence is Claude-only)"; fi
  fi
  rm -f "$rout"
  printf '%s' "$tok" | node "$KIT/scope.mjs" revoke
  return $rc
}

work_codex() {   # $1 prompt, $2 grant, $3 batch file, $4 lane, $5 session name, rest = launcher (owner lane only)
  local prompt=$1 tok=$2 bf=$3 lane=$4 name=$5 ev="$STATE/codex-run.$$.jsonl" rc soulf extra=() xbin=$CODEX_BIN; shift 5
  [[ $# -gt 0 ]] && xbin=codex
  soulf=$(soul_file "$lane"); [[ $(readlink -f "$STATE") == "$(readlink -f "$WORKSPACE")"/* ]] || extra=(--add-dir "$STATE")
  (cd "$WORKSPACE" && exec env BEING_LANE="$lane" BEING_SESSION_NAME="$name" BEING_VOICE="$([[ ${BEING_VOICE_PASS:-on} == off ]] || echo fast)" \
    BEING_SEND_TOKEN="$tok" BEING_REPLY_TO="$(reply_map "$bf")" "$@" "$xbin" exec --json --skip-git-repo-check -C "$WORKSPACE" \
    -s workspace-write "${extra[@]}" -c sandbox_workspace_write.network_access=true -c model_reasoning_effort=medium \
