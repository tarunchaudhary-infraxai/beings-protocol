#!/usr/bin/env bash
# being-routine <name> [--dry-run]: start one scheduled routine with a signed grant for that routine's own chats only.
# Routines are declared in BEING_ROUTINES_FILE (see routines.conf.example and README "Script notes").
set -euo pipefail
KIT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [[ -f $KIT/.env ]]; then set -a; . "$KIT/.env"; set +a; fi
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
CONF=${BEING_ROUTINES_FILE:-$KIT/routines.conf}
SPEC=${BEING_ROUTINE_SPEC:-scripts/routines.sh}
OWNER_DM=${OWNER_DM_CHAT:?OWNER_DM_CHAT not set (the owner 1:1 chat id)}
name=${1:?routine name}; dry=0; [[ ${2:-} == --dry-run ]] && dry=1
chats=$(awk -v n="$name" '$1 == n && $1 !~ /^#/ { print $2; exit }' "$CONF" 2>/dev/null || true)
[[ -n $chats ]] || { echo "unknown routine: $name" >&2; exit 2; }
chats=$(printf '%s' "$chats" | tr ',' '\n' | sed "s|^owner\$|$OWNER_DM|" | paste -sd, -)
scope="routine:$chats"
S="${BEING_STATE_DIR:-$KIT/state}/routine-$name-$(date +%F).done"
[[ -e $S ]] && { echo "already done today ($S)"; exit 0; }
prompt="Scheduled routine: $name. Do exactly what the mode $name) in $SPEC does (read that section first: same sources, audience, shape, exclusions and destination chat), adapted to this host: read ${OWNER_NAME:-the owner}'s mail and calendar only through the kit's read-only owner-mail / owner-read, post through teams-send-dm.mjs --chat with the chat id named in that section, and skip any source that isn't on this host (say which in the result). Post once. If today's post already exists in that chat, don't post again. Then touch $S."
if (( dry )); then echo "routine $name: scope $scope; would run: being-job agent routine-$name --notify $OWNER_DM <prompt>"; exit 0; fi
export BEING_SEND_TOKEN; BEING_SEND_TOKEN=$(node "$KIT/scope.mjs" mint "$scope" 1)
trap 'printf %s "$BEING_SEND_TOKEN" | node "$KIT/scope.mjs" revoke' EXIT
"$KIT/being-job" agent "routine-$name" --notify "$OWNER_DM" "$prompt"
