# Template. Install as ~/.config/systemd/user/<BEING_NAME>-deadman.timer next to <BEING_NAME>-deadman.service.
[Unit]
Description=@BEING_NAME@ dead-man check every 5 min (separate from @BEING_NAME@-teams.service)

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
