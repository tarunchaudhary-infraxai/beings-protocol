#!/usr/bin/env bash
# owner-mail: READ-ONLY view of the owner's mailbox. Sending as the owner goes through draft-for-owner.mjs + approve.mjs only.
#   owner-mail --list [--top N] [--unread] | --search <text> | --read <id> | --attachments <id> [--save <dir>]
set -euo pipefail
KIT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for a in "$@"; do [[ "$a" == --send || "$a" == --detect ]] && { echo "owner-mail is read-only; stage a draft with draft-for-owner.mjs --mail" >&2; exit 2; }; done
set -a
# shellcheck source=/dev/null
. "$KIT/.env"
set +a
# Allowed only under a full or owner-only grant minted by the handler (scope.mjs).
node "$KIT/scope.mjs" owner-read-ok || { echo "blocked: only owner-lane runs may read the owner's mail" >&2; exit 3; }
[[ "${BEING_OWNER_DELEGATE:-0}" == 1 && -s "${OWNER_CACHE:-}" ]] || { echo "no owner delegate sign-in (off unless BEING_OWNER_DELEGATE=1 and OWNER_CACHE)" >&2; exit 1; }
OM="${OWNER_MAIL_CACHE:-}"; [[ -n "$OM" ]] || { OM="$(dirname "$OWNER_CACHE")/owner-outlook-cache.json"; [[ -s "$OM" ]] || OM="$OWNER_CACHE"; }
BEING_CACHE="$OWNER_CACHE" BEING_MAIL_CACHE="$OM" BEING_UPN="$OWNER_UPN" BEING_READ_ONLY=1 BEING_COMMS_LOG=/dev/null exec node "$KIT/mail.mjs" "$@"
