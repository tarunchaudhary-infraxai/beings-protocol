#!/usr/bin/env python3
"""being-watchdog: one alert when a job or work run is idle for BEING_STALL_MIN minutes; marks vanished jobs died.
Activity = transcript/log writes or CPU use anywhere in the job's process tree. A job whose tree only sleeps in a wait
loop (queued behind other work) is waiting its turn, not stuck. Alerts carry the last tool action from the transcript."""
import glob, json, os, re, subprocess, time, uuid
from datetime import datetime

KIT = os.path.dirname(os.path.realpath(__file__))
# Run standalone too: fill missing settings from the kit's .env.
if os.path.exists(os.path.join(KIT, ".env")):
    for l in open(os.path.join(KIT, ".env")):
        k, _, v = l.split("#", 1)[0].strip().partition("=")
        if k and v.strip(): os.environ.setdefault(k, v.strip())
STATE = os.environ["BEING_STATE_DIR"]
NAME = os.environ["BEING_NAME"]
STALL_MIN = int(os.environ.get("BEING_STALL_MIN", "10"))
WORKSPACE = os.environ.get("BEING_WORKSPACE") or os.path.dirname(os.path.dirname(KIT))
CLAUDE_DIR = os.path.expanduser("~/.claude/projects/" + re.sub(r"[/.]", "-", os.path.realpath(WORKSPACE)))
SEEN = os.path.join(STATE, "watchdog.json")
seen = json.load(open(SEEN)) if os.path.exists(SEEN) else {}

def claude_files(sid):
    return [os.path.join(CLAUDE_DIR, sid + ".jsonl")] + glob.glob(os.path.join(CLAUDE_DIR, sid, "subagents", "*.jsonl"))

def last_action(path):
    """The newest tool call in a Claude Code transcript, as "Tool: what"."""
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, os.path.getsize(path) - 262144))
            rows = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    for l in reversed(rows):
        try: e = json.loads(l)
        except ValueError: continue
        for c in reversed((e.get("message") or {}).get("content") or []):
            if isinstance(c, dict) and c.get("type") == "tool_use":
                i = c.get("input") or {}
                what = i.get("description") or i.get("command") or i.get("file_path") or i.get("pattern") or ""
                return f"{c.get('name')}: {' '.join(str(what).split())[:140]}"
    return ""

def last_activity(paths):
    ts = [os.path.getmtime(p) for p in paths if os.path.exists(p)]
    return max(ts) if ts else None

def proc_table():
    """pid -> (ppid, cpu ticks, cmdline) for every live process (Linux /proc)."""
    t = {}
    for d in os.listdir("/proc"):
        if not d.isdigit(): continue
        try:
            st = open(f"/proc/{d}/stat").read().rsplit(")", 1)[1].split()
            t[int(d)] = (int(st[1]), int(st[11]) + int(st[12]), open(f"/proc/{d}/cmdline", "rb").read())
        except (OSError, IndexError, ValueError):
            pass
    return t

def job_tree(procs, jid):
    todo = [p for p, (_, _, c) in procs.items() if b"__exec" in c and jid.encode() in c]
    kids, out = {}, []
    for p, (pp, _, _) in procs.items(): kids.setdefault(pp, []).append(p)
    while todo:
        p = todo.pop(); out.append(p); todo += kids.get(p, [])
    return out

IDLE = {b"bash", b"sh", b"dash", b"sleep", b"flock", b"timeout", b"python3", b"python", b"inotifywait"}
WAIT = {b"sleep", b"flock", b"inotifywait"}

def queued(procs, tree):
    """True while the tree only waits (sleep/flock in a shell loop): queued behind other jobs, not stuck."""
    names = [os.path.basename(procs[p][2].split(b"\x00")[0]) for p in tree if procs.get(p) and procs[p][2]]
    return any(n in WAIT for n in names) and all(n in IDLE for n in names)

def alert(key, html):
    if key in seen: return
    r = subprocess.run(["node", os.path.join(KIT, "teams-send-dm.mjs"), "--verbatim"], input=html, text=True, capture_output=True)
    if r.returncode == 0: seen[key] = datetime.now().isoformat()

def stalled(what, since, action=""):
    esc = lambda t: t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    return (f"<p>⏱ <b>Needs a look: {what}</b></p><p>No CPU and no output for {int((time.time() - since) // 60)} min "
            f"(last at {datetime.fromtimestamp(since):%H:%M}).</p>"
            + (f"<p>Last action: <code>{esc(action)}</code></p>" if action else "")
            + "<p>It may be waiting on a prompt or a connection. Reply here if you want it stopped or restarted.</p>")

now = time.time()
procs = proc_table()
cpu_seen = seen.setdefault("_cpu", {})
for jf in glob.glob(os.path.join(STATE, "jobs", "*.json")):
    d = json.load(open(jf))
    if d.get("status") != "running": continue
    files = claude_files(d["session_id"]) if d["kind"] == "agent" and d.get("session_id") else \
        [os.path.join(STATE, "jobs", d["id"] + (".events.jsonl" if d["kind"] == "codex" else ".log"))]
    # A run job that resumes a Claude session writes that session's transcript, not its own log.
    pl = [str(x) for x in d.get("payload") or []]
    resumed = [pl[i + 1] for i, x in enumerate(pl[:-1]) if x in ("--resume", "-r") and re.fullmatch(r"[A-Za-z0-9-]{8,100}", pl[i + 1])]
    for sid in resumed: files += claude_files(sid)
    started = datetime.fromisoformat(d["started"]).timestamp()
    t = last_activity(files) or started
    tree = job_tree(procs, d["id"])
    cpu, prev = (sum(procs[p][1] for p in tree) if tree else None), cpu_seen.get(d["id"])
    if cpu is not None and (prev is None or cpu != prev[0]): prev = [cpu, now]
    if prev: cpu_seen[d["id"]] = prev; t = max(t, prev[1])
    if cpu is None and now - started > 120:
        # Process gone (kill, reboot, session limit): fix the record and say so once.
        d.update(status="died", exit=-1, finished=datetime.now().astimezone().isoformat())
        json.dump(d, open(jf, "w"), indent=2)
        alert("job:" + d["id"], f"<p>Job “{d['name']}” stopped unexpectedly (its process is gone). Marked as died; "
              f"log: <code>being-job log {d['id']}</code>.</p>")
    elif queued(procs, tree):
        continue   # waiting its turn behind other jobs
    elif now - t > STALL_MIN * 60:
        tx = [f for f in files if f.endswith(".jsonl") and CLAUDE_DIR in f and os.path.exists(f)]
        act = last_action(max(tx, key=os.path.getmtime)) if tx else f"see being-job log {d['id']}"
        alert("job:" + d["id"], stalled(f"job “{d['name']}”", t, act))

owner_sid = str(uuid.uuid5(uuid.NAMESPACE_URL, f"being-daily/{NAME}/{datetime.now():%Y-%m-%d}"))
for bf in glob.glob(os.path.join(STATE, "work.*.jsonl")):
    pid = bf.rsplit(".", 2)[-2]
    if not pid.isdigit() or not os.path.exists(f"/proc/{pid}"): continue
    try: sid = open(os.path.join(STATE, f"work-session.{pid}")).read().split()[0]   # the lane session this run is in
    except (OSError, IndexError): sid = owner_sid
    t = last_activity(claude_files(sid) + [bf])
    if t and now - t > STALL_MIN * 60:
        alert(f"run:{pid}", stalled("the current Teams task", t, last_action(claude_files(sid)[0])))

json.dump(seen, open(SEEN, "w"), indent=1)
