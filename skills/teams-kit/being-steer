#!/usr/bin/env python3
"""being-steer <session name> "<message>": reach another session live, else as a durable note in its lane's queue.
   exit 0 delivered or queued | 2 unknown session / bad input | 3 refused (scope, secrets) | 4 not reachable"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import mesh

if len(sys.argv) < 3 or sys.argv[1].startswith("-"):
    print(__doc__, file=sys.stderr); sys.exit(2)
text = " ".join(sys.argv[2:]) if sys.argv[2] != "-" else sys.stdin.read()
rc, msg = mesh.steer(sys.argv[1], text)
print(msg, file=sys.stderr if rc else sys.stdout)
sys.exit(rc)
