# Copy to .env (chmod 600, never commit), fill, then: set -a; . ./.env; set +a
# The file is sourced by bash: quote any value with spaces or quotes, e.g. OWNER_NAME='Sam Lee'.
# ---- Being identity (its own Microsoft 365 account) ----
BEING_NAME=nova                       # name people use in chat; matched as a word in group messages
BEING_UPN=                            # the Being's sign-in, e.g. nova@your-tenant.example
BEING_STATE_DIR=                      # absolute path to <kit>/state (gitignored)
BEING_CACHE=                          # absolute path to <kit>/state/token-cache.json (0600, never share)
BEING_COMMS_LOG=                      # optional; default <state>/comms.jsonl
# ---- Owner (the human partner) ----
OWNER_NAME=                           # how prompts refer to the owner
OWNER_UPN=
OWNER_OID=                            # owner's object id: teams-read.mjs --whoami run with the owner cache
BEING_OWNER_DELEGATE=0                # 1 = allow the owner delegate sign-in below. OFF by default: GUARDRAILS.md "Threat model"
OWNER_CACHE=                          # owner's delegate cache for owner-read/owner-mail/approve; separate file, two-user host only
# ---- Entra app registration (public client, delegated permissions) ----
M365_CLIENT_ID=
M365_TENANT_ID=
# ---- Model routing (see docs/MODEL_ROUTING.md) ----
BEING_FAST_CLIENT=codex               # triage + voice: codex | claude
BEING_FAST_MODEL=haiku                # used when BEING_FAST_CLIENT=claude
BEING_FAST_EFFORT=low                 # used when BEING_FAST_CLIENT=codex
BEING_SESSION_MODEL=opus              # daily work session
BEING_JOB_MODEL=opus                  # big jobs: research, reviews, multi-step builds
BEING_JOB_MODEL_SMALL=sonnet          # small jobs: lookups, account chores, probes (being-job --small)
# ---- Runner ----
BEING_TICK_SEC=30
BEING_STALL_MIN=10                    # watchdog: alert after this many idle minutes
BEING_MAIL_WATCH=1                    # 0 disables the mailbox watcher
BEING_DETECT_CHATS=50                 # chats swept per tick, most recently active first (README "Detection limits")
BEING_DETECT_MESSAGES=8               # newest messages read per chat per tick (max 50)
BEING_DETECT_PAGES=5                  # pages read back per chat when a burst fills the first page (max 20)
BEING_NAME_ALIASES=                   # other names that wake the Being in groups, comma-separated
BEING_NAME_STOPLIST=                  # phrases containing the name that never wake it (e.g. a place), comma-separated
# ---- Isolation (GUARDRAILS.md "Threat model") ----
BEING_MODEL_USER=                     # OS user the model runs as, if not this one; checked by being-teams doctor
BEING_SINGLE_USER_ACK=0               # 1 = no second user possible: doctor warns instead of failing (owner sign-in must be off),
                                      #     teammate lanes lose skipped permissions and get the BEING_TEAM_TOOLS allowlist
BEING_TEAM_TOOLS=                     # optional allowlist override for teammate runs (comma-separated Claude Code tool rules)
BEING_TEAM_JOB_TOOLS=                 # same, for jobs started from a teammate chat (default: read/edit files, read-only git)
BEING_FENCE_DENY=                     # extra private-path regexes teammate runs may not touch, comma-separated
# BEING_FENCE_DEADLINE=               # optional; seconds (1-20); can only shorten the fence's 20 s check deadline
BEING_ISOLATION=off                   # off | bwrap | users; read isolation/README.md first
BEING_ISOLATION_LANES=all             # all | team (sandbox teammate lanes only)
# BEING_RUN_DIR=                      # optional; default <state>/run
# BEING_TEAM_ROOT=                    # optional; default <state>/team-lanes
# BEING_TEAM_USER=                    # users mode: OS user for teammate lanes; default <being>-team
# BEING_SHIM_DIR=                     # optional; default <kit>/isolation/shims
BEING_BROKER_RAW_JOBS=0
# BEING_MODEL_RUN=                    # users mode: model launcher; default under /usr/local/libexec
BEING_MODEL_SECRETS=hide
# BEING_CLAUDE_BIN=                   # optional; default: claude on PATH
# BEING_CLAUDE_ENV_DIR=               # users mode: model client env dir; default under /etc
# BEING_SANDBOX_CLAUDE_ENV=           # optional env file for sandboxed model runs
BEING_SANDBOX_MODEL_PROXY=1           # 1 = sandboxed runs reach the model through model-proxy.mjs
# BEING_SANDBOX_NET=none              # none (default): proxied teammate runs get no host network; host = shared
# BEING_SANDBOX_MODEL_PORT=8462       # optional; model relay's loopback port inside the run's own network
# BEING_PROXY_CLAUDE=                 # optional; model client the proxy uses to refresh its sign-in
# BEING_PROXY_CRED=                   # optional; sign-in file the proxy reads (default in model-proxy.mjs)
# BEING_PROXY_UPSTREAM=               # optional; model API base URL
# ---- Owner context and soul ----
OWNER_DM_CHAT=                        # chat id of the owner's 1:1 with the Being
# BEING_SOUL_FILE=                    # optional; default <workspace>/.beings/SOUL.md
# BEING_SOUL_PUBLIC_SECTIONS=         # optional; SOUL.md sections teammate lanes see, |-separated
# BEING_SOUL_PRIVATE_MARKERS=         # optional; extra regexes that drop a line from the public soul, comma-separated
# BEING_BOND_FILES=                   # optional; owner-lane bond files, comma-separated (default in soul.py)
# BEING_OWNER_REGISTER=               # optional; register line for the owner lane
# BEING_TEAM_PIPELINE=                # optional; share: team pipeline file for warm-lane digests
BEING_DIGEST_MAX=12000
BEING_NOTE_MAX=1500
BEING_FENCE_PERSONAL_WORDS=           # extra words that mark a note as personal, comma-separated
# BEING_PRIVATE_DIR=                  # optional; private workspace dir (default in team-fence.py)
# BEING_TEAM_SHARE_DIRS=              # optional; workspace dirs synced to teammate lanes, comma-separated
# ---- Triage, voice and acks ----
BEING_TRIAGE=on                       # off = every message goes to the work step
BEING_TRIAGE_RECENT=8
BEING_VOICE_PASS=on                   # off = messages are sent as written
BEING_SEEN_REACT=0                    # 1 = instant seen reaction on the owner's 1:1 messages
BEING_ACK_DEFER_S=60                  # 0 = send the ack at once
BEING_GROUP_OWNER_WAKES=1             # 0 = the owner's group messages need the Being's name
BEING_INJECT=1                        # deliver new messages into a live run of the same lane
BEING_INJECT_GRACE=30
BEING_INJECT_POLL=5
BEING_DETECT_OVERLAP_SEC=120
# HOOK_STATE=                         # optional; webhook state dir, default ~/.local/state/graph-webhook
# ---- Warm lanes and steering ----
BEING_FAST_WARM=1
# BEING_FAST_WARM_CMD=                # optional; command for warm sessions
BEING_FAST_WARM_IDLE_MIN=120
BEING_FAST_WARM_TIMEOUT_MS=15000
BEING_FAST_WARM_TURNS=30
BEING_STEER_CMD=claude
BEING_STEER_MODEL=haiku
# BEING_CLAUDE_SESSIONS_DIR=          # optional; default ~/.claude/sessions
# ---- Retry and dead-man check ----
BEING_RETRY_MAX=3
BEING_RETRY_BACKOFF_SEC=120,600,1800
BEING_RETRY_DISPATCH=1
BEING_RETRY_NOTIFY=1
BEING_DEADMAN_WATERMARK_MIN=10
BEING_DEADMAN_LOG_MIN=180
BEING_DEADMAN_REMIND_MIN=120
BEING_DEADMAN_SKIP_UNIT=0
# BEING_ALERT_ENV=                    # optional; alert settings file holding the keys below (default in being-deadman)
# BEING_ALERT_CHANNEL=none            # none | ntfy | telegram | command
# BEING_ALERT_COMMAND=                # command mode: message on stdin
# BEING_ALERT_PING_URL=               # optional outside ping
# ---- Routines ----
# BEING_ROUTINES_FILE=                # optional; default <kit>/routines.conf (gitignored)
BEING_ROUTINE_SPEC=                   # workspace file describing each routine mode
# ---- Hive ----
# BEING_HIVE_MCP=                     # optional; default ~/.local/bin/hive-mcp
# BEING_HIVE_AS=                      # optional; default <being name>-box
BEING_HIVE_SSH=hive                   # ssh alias used by hive-mcp-stdio
# Set by the kit or tests, not here: BEING_SESSION_NAME, BEING_BROKER_SOCK, BEING_BROKER_DRY, BEING_LAUNCH_DRY,
# BEING_MESH_NO_WAKE, BEING_REAL_SOUL, PROXY_SOCKET. Removed: BEING_TEAMS_SYSTEMD.
