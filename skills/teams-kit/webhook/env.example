# Graph webhook settings: ~/.config/graph-webhook/env (0600). Read by systemd: plain KEY=value, no quotes or $HOME.
# The Being's identity (BEING_UPN, BEING_CACHE, M365_*) comes from the Teams kit .env.

# Public https address that forwards to the receiver, e.g. https://<being>-hook.<domain> (no trailing path).
HOOK_PUBLIC=https://@BEING_NAME@-hook.<domain>
# Local port of the receiver (127.0.0.1 only); the tunnel route points here.
HOOK_PORT=8790
# hook-wait: tick while the subscription is healthy (seconds).
HOOK_SLOW_TICK=300
