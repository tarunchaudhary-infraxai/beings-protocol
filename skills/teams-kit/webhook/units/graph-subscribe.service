# Template: webhook/kit-install.sh writes this to ~/.config/systemd/user/ (@KIT@ = the Teams kit dir). Off until enabled.
[Unit]
Description=Create or renew the Graph chat-message subscription
After=graph-webhook.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment="HOOK_STATE=@HOOK_STATE@"
EnvironmentFile=%h/.config/graph-webhook/env
WorkingDirectory=@KIT@
ExecStart=/usr/bin/env node @KIT@/webhook/graph-subscribe.mjs ensure
UMask=0077
