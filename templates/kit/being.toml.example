# being.toml: one file with a Being's settings. Used by `install.sh --config being.toml` and `being access`.
# Format: a TOML subset (one-level [tables]; strings, integers, true/false, arrays; # comments). See docs/OPERATIONS_KIT.md.

[being]
name = "nova"                 # what people call the Being in chat (lowercase letters, digits, dashes)
owner = "Sam Lee"             # the human partner
# tz = "Area/City"            # schedules and dates; default: the box's timezone
# track_private = false       # true = commit .beings-local/ (default: never committed)

[kit]
# Optional components, same as --with. Built in: operations, teams-kit, statusline; others are skills/<name>/.
with = ["operations"]

[access]
# What the Being may use. Everything is off unless listed here (or set to true). `being access` shows this list.
allow = [
  "teams-owner-chat",         # Being: Teams 1:1 with the owner (required)
  "claude-code",              # Being: Claude Code seat on this box
  "memory",                   # local memory search
]
# teams-teammates = true      # Being: reply to teammates in their own chat
# teams-groups = true         # Being: group chats and channels
# being-mail = true           # Being: its own mailbox (Outlook session)
# being-files = true          # Being: its own OneDrive
# codex = true                # Being: Codex login on this box
# owner-teams-read = true     # owner's Teams, read only (owner Teams session)
# owner-teams-send = true     # owner's Teams, send after approval
# owner-mail-read = true      # owner's mail, read only (owner Outlook session)
# owner-mail-send = true      # owner's mail, send after approval
# owner-web = true            # owner's browser session: files and web pages, read only
# github = true               # Being's own GitHub account or a repo-limited token
# cloud-cli = true            # cloud CLIs (very high risk: name the account in TOOLS.md)
